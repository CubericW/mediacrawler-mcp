# ---- Required ----------------------------------------------------------------
# Absolute path to your cloned MediaCrawler repo (must contain main.py).
# Clone it first:  git clone https://github.com/NanmiCoder/MediaCrawler
MEDIACRAWLER_HOME=/absolute/path/to/MediaCrawler

# ---- Runner ------------------------------------------------------------------
# How to invoke MediaCrawler. "uv" (recommended) -> `uv run main.py ...`.
# Use "python" if you installed deps into a plain venv and activate it yourself.
MEDIACRAWLER_RUNNER=uv

# Login method passed to --lt: qrcode | phone | cookie
MEDIACRAWLER_LOGIN_TYPE=qrcode

# Output format written by MediaCrawler: json (recommended) | csv | sqlite | db
MEDIACRAWLER_SAVE_OPTION=json

# ---- Anti-ban / safety guardrails -------------------------------------------
# Default number of items when a tool call omits max_count.
MEDIACRAWLER_DEFAULT_MAX=20
# Absolute hard ceiling on items per call. Requests above this are clamped.
MEDIACRAWLER_MAX_HARD_LIMIT=100
# Random delay window (seconds) between requests.
MEDIACRAWLER_DELAY_MIN=2
MEDIACRAWLER_DELAY_MAX=5
# Local sliding-window rate limit: max tool calls per window.
MEDIACRAWLER_RATE_CALLS=10
MEDIACRAWLER_RATE_WINDOW=600
# Collect comments by default (true/false).
MEDIACRAWLER_ENABLE_COMMENTS=true
# Use CDP mode (reuse your logged-in Chrome) to reduce risk-control detection.
MEDIACRAWLER_ENABLE_CDP=true
# Enable MediaCrawler's IP proxy pool (requires proxy config in MediaCrawler).
MEDIACRAWLER_ENABLE_PROXY=false
# Per-run subprocess timeout (seconds).
MEDIACRAWLER_RUN_TIMEOUT=300
# How long a crawl may wait for the crawls ahead of it (seconds). Crawls run one at a time.
MEDIACRAWLER_QUEUE_TIMEOUT=3600
